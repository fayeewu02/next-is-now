{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextNow Entry v1 snapshot",
  "description": "Documentation contract for existing entries; not an auto-migration mandate or seed. Preserve unknown legacy fields.",
  "type": "object",
  "required": ["id","itemId","title","category","minutes","createdAt","text","photos"],
  "properties": {
    "id": {"type":"string"},
    "itemId": {"type":"string"},
    "title": {"type":"string"},
    "category": {"type":"string"},
    "minutes": {"type":"number","minimum":0},
    "durationLabel": {"type":"string"},
    "activity": {"type":"string"},
    "materials": {"type":"array","items":{"type":"object","required":["id","label"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"optional":{"type":"boolean"}},"additionalProperties":true}},
    "steps": {"type":"array","items":{"type":"string"}},
    "source": {"type":"object","description":"Original saved item, cropped cover metadata and cover-based guide snapshot.","additionalProperties":true},
    "adaptation": {"type":"string","enum":["original","omit","demo-adapted","adapted"]},
    "demoAlternative": {"type":"object","description":"Entire accepted fictional demo result; original reference remains in source.","additionalProperties":true},
    "createdAt": {"type":"number","description":"Epoch milliseconds"},
    "completedAt": {"type":"number","exclusiveMinimum":0,"description":"Finite positive epoch milliseconds; do not reset when editing"},
    "completionMethod": {"type":"string","enum":["explicit","record"]},
    "updatedAt": {"type":"number"},
    "text": {"type":"string","description":"UI counts Array.from(text).length <= 300, not UTF-16 code units"},
    "photos": {"type":"array","maxItems":5,"items":{"type":"object","required":["id","data","name"],"properties":{"id":{"type":"string"},"data":{"type":"string","pattern":"^data:image/","description":"New uploads are WebP data URLs; old photo types remain compatible"},"name":{"type":"string"}},"additionalProperties":true}}
  },
  "additionalProperties": true
}
